# Copy to the web-server environment; do not commit real values.
MAMBO_ADMIN_EMAIL=admin@mamboyatanga.co.tz
MAMBO_ADMIN_PASSWORD=replace-before-first-run

# Provider registry flags are deliberately off until sandbox approval.
MAMBO_PAYMENT_ENV=sandbox
MAMBO_MANUAL_PAYMENT_NUMBER=
MAMBO_PAYMENT_CALLBACK_URL=https://example.invalid/api/index.php?action=payment-webhook
MAMBO_PROVIDER_MPESA_ENABLED=0
MAMBO_PROVIDER_HALOPESA_ENABLED=0
MAMBO_PROVIDER_MIXX_BY_YAS_ENABLED=0
MAMBO_PROVIDER_AIRTELMONEY_ENABLED=0
MAMBO_PROVIDER_CRDB_ENABLED=0
MAMBO_PROVIDER_NMB_ENABLED=0

# SMS adapter placeholder. No provider calls are made by this release.
MAMBO_SMS_ENABLED=0
MAMBO_SMS_PROVIDER=
MAMBO_SMS_BASE_URL=
MAMBO_SMS_SENDER_ID=
MAMBO_SMS_API_KEY=
MAMBO_SMS_API_SECRET=
